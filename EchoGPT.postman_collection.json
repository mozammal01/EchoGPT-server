						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"User@123456\",\n  \"newPassword\": \"NewPassword@123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["users", "change-password"]
						}
					}
