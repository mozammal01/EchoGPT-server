						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"prompt\": \"Explain Quantum Computing in simple terms.\",\n  \"model\": \"gpt-4o\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat/completions",
							"host": ["{{baseUrl}}"],
							"path": ["chat", "completions"]
