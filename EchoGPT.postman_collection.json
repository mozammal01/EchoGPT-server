						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"NestJS Prisma best practices 2026\",\n  \"limit\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/web-search",
							"host": ["{{baseUrl}}"],
							"path": ["web-search"]
						}
					}
				},
				{
					"name": "Get Search History",
					"request": {
						"method": "GET",
