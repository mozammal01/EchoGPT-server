# Application Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://echogpt:echogpt_pass@localhost:5432/echogpt_db?schema=public

# JWT Security
JWT_SECRET=echogpt_super_secret_jwt_access_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=echogpt_super_secret_jwt_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for AI Provider API Keys (32 chars)
ENCRYPTION_KEY=echogpt_aes_256_secret_key_32c!

# AI Provider Default Keys (Optional fallback)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
